# LLM provider for answer generation: ollama (fully local) or groq (hybrid)
AGENTIC_CRAG_LLM_PROVIDER=ollama

# Groq (used when AGENTIC_CRAG_LLM_PROVIDER=groq)
GROQ_API_KEY=replace-with-your-groq-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_PLANNER_MODEL=openai/gpt-oss-20b

# Ollama (used when AGENTIC_CRAG_LLM_PROVIDER=ollama; requires a running `ollama serve`)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_PLANNER_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CONTEXT_WINDOW=8192

# Storage root (the EC2 setup script replaces this with /opt/agentic-crag/data)
AGENTIC_CRAG_STORAGE_DIR=.agentic_crag_data

# Bounded agent controls
AGENTIC_CRAG_AGENT_TIMEOUT_SECONDS=30
AGENTIC_CRAG_AGENT_TOKEN_LIMIT=12000

# Upload validation
AGENTIC_CRAG_MAX_UPLOAD_MB=10
