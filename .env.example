# LLM provider for answer generation: ollama (fully local) or groq (hybrid)
INSIGHT_LLM_PROVIDER=ollama

# Groq (used when INSIGHT_LLM_PROVIDER=groq)
GROQ_API_KEY=replace-with-your-groq-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_PLANNER_MODEL=openai/gpt-oss-20b

# Ollama (used when INSIGHT_LLM_PROVIDER=ollama; requires a running `ollama serve`)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_PLANNER_MODEL=llama3.2:3b
OLLAMA_JUDGE_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CONTEXT_WINDOW=8192

# Storage root (the EC2 setup script replaces this with /opt/insight-ai/data)
INSIGHT_STORAGE_DIR=.insight_data

# Bounded agent controls
INSIGHT_AGENT_MAX_ITERATIONS=4
INSIGHT_AGENT_TIMEOUT_SECONDS=30
INSIGHT_AGENT_TOKEN_LIMIT=12000

# Upload validation
INSIGHT_MAX_UPLOAD_MB=10
