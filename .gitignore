# Keep the repository ignore file visible even if a global exclude hides it.
!.gitignore

# Python environments, bytecode, and packaging output
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.eggs/
*.egg-info/
build/
dist/

# Local configuration and application data
.env
.env.*
!.env.example

.insight_data/
INSIGHT_AI_storage/
uploads/
indexes/
registry.json

# Test, evaluation, lint, type-check, and coverage artifacts
.pytest*/
.eval-storage-*/
.deepeval/
.hypothesis/
.mypy_cache/
.pyright/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Notebook, editor, and local agent settings
.ipynb_checkpoints/
.streamlit/
.idea/
.vscode/
.claude/
.agents/

# Logs, temporary files, and OS metadata
*.log
*.tmp
*.temp
*.bak
*.swp
*~
.DS_Store
Thumbs.db
Desktop.ini

fix_log.md
CLAUDE.md
